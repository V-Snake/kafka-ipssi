# Configuration Hadoop pour un cluster mono-noeud utilisé dans l'exercice 7.

# FS par défaut : pointe sur le NameNode du compose
CORE_CONF_fs_defaultFS=hdfs://hdfs-namenode:9000

# Utilisateur HTTP simple pour les UIs/WebHDFS
CORE_CONF_hadoop_http_staticuser_user=root

# Simplifier les droits + réplication mono noeud + activer WebHDFS
HDFS_CONF_dfs_permissions_enabled=false
HDFS_CONF_dfs_replication=1
HDFS_CONF_dfs_webhdfs_enabled=true

# Dossiers de stockage NN/DN
HDFS_CONF_dfs_namenode_name_dir=file:///hadoop/dfs/name
HDFS_CONF_dfs_datanode_data_dir=file:///hadoop/dfs/data

# Eviter les checks IP/hostname
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false

# Rendre les redirections WebHDFS "résolvables" côté client :
#  - Demande au client d'utiliser les hostnames des DataNodes
#  - Demande aux DataNodes d'annoncer/consommer via hostnames
HDFS_CONF_dfs_client_use_datanode_hostname=true
HDFS_CONF_dfs_datanode_use_datanode_hostname=true
